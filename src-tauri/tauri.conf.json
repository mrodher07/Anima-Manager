{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anima Manager",
  "mainBinaryName": "anima-manager",
  "version": "../package.json",
  "identifier": "io.github.mrodher07.animamanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Anima Manager",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: https://*.supabase.co",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mrodher07",
    "category": "RolePlayingGame",
    "shortDescription": "Gestor de partidas y personajes para Anima Beyond Fantasy",
    "longDescription": "Fichas calculadas como la hoja de la comunidad, campañas, bestiario, combate y mapa de batalla para Anima Beyond Fantasy. Funciona sin conexión; con cuenta, se sincroniza con la mesa.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
